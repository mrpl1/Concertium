# --- Database (MySQL) ---
# Local dev: start MySQL with `docker compose up -d`, then use:
DATABASE_URL="mysql://concertium:concertium@localhost:3306/concertium"
# Production (Hostinger): use the connection string from hPanel → MySQL, e.g.
#   DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"

# --- Auth ---
# Secret used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="please-change-this-to-a-long-random-string"

# Initial admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@concertium.local"
SEED_ADMIN_PASSWORD="changeme123"

# --- Email sending (optional) ---
# Leave these unset to use "draft in your mail client" mode only.
# Fill them in to enable automatic sending of status reports.
#
# Gmail example (use an App Password, not your normal password):
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT="465"
#   SMTP_SECURE="true"
#   SMTP_USER="you@gmail.com"
#   SMTP_PASS="your-16-char-app-password"
#   SMTP_FROM="Concertium Reports <you@gmail.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- Automations (optional) ---
# Slack Incoming Webhook for alert digests. Leave blank to disable Slack.
SLACK_WEBHOOK_URL=""
# Where daily alert digests are emailed (comma-separated). Falls back to all
# admin users if blank.
NOTIFY_EMAIL=""
# Secret that guards the /api/cron scheduler endpoint. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Leave blank to disable the scheduled endpoint (manual runs still work).
CRON_SECRET=""
# Day of week to send weekly client reports (0=Sun … 6=Sat). Default 5 (Fri).
WEEKLY_REPORT_DAY="5"

# In-process scheduler (for an always-on host like a Mac mini). When "true",
# the running server sends the daily alert digest at ~SCHEDULER_HOUR local time
# and weekly reports on WEEKLY_REPORT_DAY — no external cron needed.
# Do NOT also run the launchd job at the same time, or alerts send twice.
ENABLE_SCHEDULER="false"
SCHEDULER_HOUR="8"
