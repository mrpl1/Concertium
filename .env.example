# --- Database (MySQL) ---
# Local dev: start MySQL with `docker compose up -d`, then use:
DATABASE_URL="mysql://concertium:concertium@localhost:3306/concertium"
# Production (Hostinger): use the connection string from hPanel → MySQL, e.g.
#   DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"

# --- Auth ---
# Secret used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="please-change-this-to-a-long-random-string"

# Initial admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@concertium.local"
SEED_ADMIN_PASSWORD="changeme123"

# --- Email sending ---
# Currently stubbed out (see src/lib/email.ts) — nodemailer/SMTP can't run on
# Cloudflare Workers (no raw TCP/TLS sockets). sendEmail() just logs for now
# until an HTTP email API (Resend/SendGrid/MailChannels) is wired in.
# SMTP_FROM is still read as the display "from" address for that future step.
SMTP_FROM=""

# --- Automations (optional) ---
# Slack Incoming Webhook for alert digests. Leave blank to disable Slack.
SLACK_WEBHOOK_URL=""
# Where daily alert digests are emailed (comma-separated). Falls back to all
# admin users if blank.
NOTIFY_EMAIL=""
# Secret that guards the /api/cron scheduler endpoint. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Leave blank to disable the scheduled endpoint (manual runs still work).
CRON_SECRET=""
# Day of week to send weekly client reports (0=Sun … 6=Sat). Default 5 (Fri).
# On Cloudflare, the daily/weekly automation run is driven by a Workers Cron
# Trigger (see wrangler.jsonc's triggers.crons + worker.ts's scheduled()
# handler) rather than an in-process scheduler.
WEEKLY_REPORT_DAY="5"
