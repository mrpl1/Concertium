// Concertium — data model
// Provider is SQLite, served by Cloudflare D1 in production via the
// @prisma/adapter-d1 driver adapter (see src/lib/db.ts). Migrations are
// generated with `prisma migrate diff` and applied with `wrangler d1
// migrations apply` — D1 doesn't support `prisma db push`/`migrate dev`.

generator client {
  provider   = "prisma-client-js"
  // "client" mode ships a pure-JS query compiler instead of the native Rust
  // query engine binary (.node file) — required for Workers, which cannot
  // load native binaries at all. Only works with a driver adapter (adapter-d1
  // here), which is all this app ever uses.
  engineType = "client"
}

datasource db {
  provider = "sqlite"
}

// A tenant. Every user belongs to exactly one workspace, and all clients,
// projects, tags, and their descendants are scoped to a workspace. Different
// workspaces are fully isolated from one another.
model Workspace {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  // Per-workspace Slack Incoming Webhook URL for the daily alert digest.
  slackWebhookUrl     String?
  weeklyReportEnabled Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users    User[]
  clients  Client[]
  projects Project[]
  tags     Tag[]
  invites  Invite[]
}

// An invite link tying a single signup to one workspace. Membership is
// invite-only after the first (bootstrap) account is created.
model Invite {
  id          String    @id @default(cuid())
  token       String    @unique
  email       String?
  role        String    @default("member")
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  acceptedAt  DateTime?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  invitedById String?
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("member") // "admin" | "member"
  createdAt    DateTime @default(now())

  // Nullable in the schema so `prisma db push` succeeds on existing rows, but
  // treated as required in application logic (every user has a workspace).
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  ownedProjects     Project[]      @relation("ProjectOwner")
  updates           StatusUpdate[]
  ownedDeliverables Deliverable[]  @relation("DeliverableOwner")
  deadlineChanges   DeadlineChange[]
  timeEntries       TimeEntry[]
  projectMemberships ProjectMember[]
  clientAssignments  ClientAssignment[]
}

model Client {
  id        String   @id @default(cuid())
  name      String
  company   String?
  email     String?
  phone     String?
  notes     String?
  // When true, the scheduled job emails this client a status report on the
  // configured weekly day (requires SMTP + the client's email).
  weeklyReport     Boolean   @default(false)
  lastReportSentAt DateTime?
  // When set, exposes a read-only public status page at /share/<shareToken>.
  shareToken       String?   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  projects Project[]
  assignees ClientAssignment[]
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String? 
  // status: "Not Started" | "On Track" | "At Risk" | "Off Track" | "On Hold" | "Completed"
  status      String    @default("Not Started")
  // priority: "Low" | "Medium" | "High"
  priority    String    @default("Medium")
  progress    Int       @default(0) // 0-100
  startDate   DateTime?
  dueDate     DateTime?
  // The originally agreed-upon due date, captured the first time a due date is
  // set. Compared against dueDate to surface deadline slippage.
  baselineDueDate DateTime?
  // Budgeted/estimated hours for the engagement (for time-tracking burn).
  budgetHours Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User?   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  updates         StatusUpdate[]
  deliverables    Deliverable[]
  deadlineChanges DeadlineChange[]
  links           ProjectLink[]
  timeEntries     TimeEntry[]
  tags            Tag[]
  members         ProjectMember[]
}

// A labeled link/resource attached to a project (SOW, contract, asset, doc…).
model ProjectLink {
  id        String   @id @default(cuid())
  label     String
  url       String 
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Logged work against a project, for budget burn.
model TimeEntry {
  id        String   @id @default(cuid())
  hours     Float
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Tag {
  id       String    @id @default(cuid())
  name     String
  projects Project[]

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

model Deliverable {
  id          String    @id @default(cuid())
  name        String
  description String? 
  // status: "Pending" | "In Progress" | "In Review" | "Approved" | "Blocked"
  status      String    @default("Pending")
  dueDate     DateTime?
  baselineDueDate DateTime?
  approvedAt  DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User?   @relation("DeliverableOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  deadlineChanges DeadlineChange[]
}

// An audit log of due-date changes for projects and deliverables, so slippage
// can be reported ("slipped twice, +12 days").
model DeadlineChange {
  id        String   @id @default(cuid())
  oldDate   DateTime?
  newDate   DateTime?
  reason    String?
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  deliverableId String?
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  changedById String?
  changedBy   User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)
}

model StatusUpdate {
  id        String   @id @default(cuid())
  body      String 
  status    String? // status snapshot at time of update
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

// A user's membership of a single project. Grants visibility of that project
// and everything hanging off it (deliverables, time entries, updates).
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // role: "lead" | "member" | "viewer"
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

// A user's assignment to a whole client. Grants visibility of that client and
// every project under it, without needing per-project membership rows.
model ClientAssignment {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([clientId, userId])
  @@index([userId])
}
