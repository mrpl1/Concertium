{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "concertium",
  "main": "worker.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "concertium" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "concertium",
      "database_id": "094db8e6-7001-4a84-80f6-2f4350bf58c6"
    }
  ],
  "vars": {
    "WEEKLY_REPORT_DAY": "5"
  },
  "triggers": {
    "crons": []
  }
}
